@@ -0,0 +1,18 @@
+"""Exclude only the exact inherited no-op process callback from proxy fanout."""
+
+from types import CodeType, MethodType
+
+from pipecat.observers.base_observer import BaseObserver
+
+_DEFAULT_PROCESS = BaseObserver.on_process_frame
+_DEFAULT_PROCESS_CODE: CodeType = BaseObserver.on_process_frame.__code__
+
+
+def is_noop_process(observer: BaseObserver) -> bool:
+    """Conservatively retain overrides, instance patches and modified function code."""
+    callback = observer.on_process_frame
+    return (
+        isinstance(callback, MethodType)
+        and callback.__func__ is _DEFAULT_PROCESS
+        and callback.__func__.__code__ is _DEFAULT_PROCESS_CODE
+    )
